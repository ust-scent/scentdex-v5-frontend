# Keeper bot (Railway service in project scentdex-keeper). Not used by Vercel.
# Node is pinned to a patch release so a rebuild cannot silently fall back to
# an older runtime (2026-10-21 Node.js security release: 22.23.4).
FROM node:22.23.4-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --omit=optional --no-audit --no-fund
COPY . .
CMD ["npm", "run", "keeper"]
